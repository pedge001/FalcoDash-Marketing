# Canonical site origin (no trailing slash). Used for OAuth redirects and host canonicalization.
SITE_URL=https://falcodash.com

# Railway Postgres. In Railway, set this to ${{Postgres.DATABASE_URL}}.
DATABASE_URL=

# Resend (https://resend.com). The sending domain (falcodash.com) must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="FalcoDash <hello@falcodash.com>"
# Comma-separated list of inboxes that receive new-lead notifications.
LEAD_NOTIFY_TO=hello@falcodash.com

# Random string used to hash IP addresses for spam rate limiting (never store raw IPs).
IP_HASH_SALT=

# Password for the admin panel at /admin (single user).
ADMIN_PASSWORD=

# GitHub OAuth app for Decap CMS at /admin/cms.
# Callback URL on the GitHub OAuth app: https://falcodash.com/api/decap/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Analytics (read at build time; leave blank to disable each one).
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=
# Only needed if you don't let Cloudflare inject Web Analytics automatically.
PUBLIC_CF_BEACON_TOKEN=

# IndexNow key (any 32-char hex string). Submits the sitemap to Bing/IndexNow once per production deploy.
INDEXNOW_KEY=

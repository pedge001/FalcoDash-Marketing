---
// 90 Day Cash Flow Fix: paid-search landing page. Facts come from src/data/cashflow.ts, and every
// claim on this page is one Patrick confirmed. Anything not yet confirmed shows as a visible
// [need: ...] placeholder (styled .need) instead of invented copy. Remove each one before launch.
//
// Flow: hero (default headline server-rendered; ?ag= swaps client-side) -> AR calculator
// (monthly revenue + days to get paid, formula on the page) -> email to get the results
// (posts to /api/contact, source=cash-flow-fix) -> booking step after submit.
// Money-back terms and the 2024 architecture-firm proof sit directly under the headline.
import Base from '~/layouts/Base.astro';
import { SITE } from '~/data/site';
import { OFFER, PROOF, HEADLINES, AR_FORMULA } from '~/data/cashflow';
import { abs, ORG_ID } from '~/lib/schema';
import CalendlyInline from '~/components/CalendlyInline.astro';

const path = OFFER.path;
const title = '90 Day Cash Flow Fix | Faster Cash for SoCal Businesses | FalcoDash';
const description =
  'Fix how you invoice and collect. Faster cash in 90 days for Southern California businesses. Reduce your AR or your money back. Based in Redlands.';
const crumbs = [{ name: 'Home', path: '/' }, { name: OFFER.name, path }];
const subhead = "We fix how you invoice and collect, so the money you've already earned reaches the bank. Reduce your AR or your money back.";

// Booking link for the step after the intake form. Set PUBLIC_BOOKING_URL to show the booking step.
// A calendly.com link renders Calendly's inline widget (so the calendly.event_scheduled postMessage
// reaches ads-conversions.ts and fires call_booked); any other link renders a plain button.
const bookingUrl = (import.meta.env.PUBLIC_BOOKING_URL || '').trim();
const isCalendly = /^https:\/\/(www\.)?calendly\.com\//i.test(bookingUrl);

const INCLUDED = [
  'Week-1 accounts to call first',
  'Collections follow-up system',
  'Weekly cash dashboard',
  'Collections playbook and scripts',
];

const STEPS = [
  { k: 'Step 01', h: '20-minute call', p: 'Tell us how invoicing and collections run today, and we will see whether the offer fits.' },
  { k: 'Step 02', h: 'System access and a day-1 AR baseline', p: 'You give us access to your systems. We record your AR over 90 days as the day-1 baseline.' },
  { k: 'Step 03', h: '90 days of work', p: 'We fix how you invoice and collect, starting with invoicing and accounts receivable.' },
  { k: 'Step 04', h: 'The day-90 AR check', p: 'We measure AR over 90 days again and compare it with day 1. If it is not lower, the guarantee applies.' },
];

const usd = (n: number) => `$${n.toLocaleString('en-US')}`;

const schema = [
  {
    '@type': 'Service',
    '@id': `${abs(path)}#service`,
    name: OFFER.name,
    serviceType: 'Invoicing and accounts receivable improvement',
    description: subhead,
    url: abs(path),
    provider: { '@id': ORG_ID },
    areaServed: { '@type': 'AdministrativeArea', name: 'Southern California' },
    audience: { '@type': 'BusinessAudience', audienceType: 'Southern California businesses with $2M+ in annual revenue' },
    offers: {
      '@type': 'Offer',
      url: abs(path),
      priceCurrency: 'USD',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: OFFER.pricePerMonth,
        priceCurrency: 'USD',
        unitCode: 'MON',
        billingDuration: { '@type': 'QuantitativeValue', value: OFFER.months, unitCode: 'MON' },
      },
    },
  },
];
---
<Base
  title={title}
  description={description}
  path={path}
  breadcrumbs={crumbs}
  schema={schema}
  ogImage="/og/cash-flow-fix.png"
  ogImageAlt="FalcoDash: 90 Day Cash Flow Fix. Faster cash in 90 days."
  headerCta={{ href: '#calculator', label: 'See cash tied up in your AR' }}
>
  <!-- 1. Hero -->
  <section class="wrap cff-hero">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">{OFFER.name} · Southern California</p>
        <h1 class="display hero-h" data-headline data-ag="default">Faster cash in <span class="butter">90 days.</span></h1>
        <p class="lede hero-lede" data-answer>{subhead}</p>
        <p class="hero-terms">If AR isn't down by day 90, we keep working until it is or you get a full refund — your choice.</p>
        <p class="hero-proof">In 2024, an architecture firm's cash in the bank rose 35% in a 90-day engagement, and its AR was cut in half.</p>
        <div class="hero-actions">
          <a href="#calculator" class="btn btn-primary" data-cta="hero-calculator"><span>See cash tied up in your AR</span><span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <aside class="seal" aria-label="The guarantee">
        <p class="seal-k">The guarantee</p>
        <p class="seal-h">{OFFER.guarantee}</p>
        <p class="seal-p">Measured on AR over 90 days, on day 1 and on day 90.</p>
        <a href="#guarantee" class="link-arrow">How it works ↓</a>
      </aside>
    </div>
    <ul class="facts" aria-label="At a glance">
      <li><span class="facts-k">For</span>Southern California businesses with $2M+ in annual revenue</li>
      <li><span class="facts-k">Starts with</span>Invoicing and accounts receivable</li>
      <li><span class="facts-k">Based in</span>Redlands, CA</li>
    </ul>
    <!-- Headline variants for ?ag= are listed here so they remain in the HTML if JS is off. The H1 above is the default (server-rendered). -->
    <ul class="sr-only" id="cff-headlines">
      <li>Default: {HEADLINES.default}</li>
      <li>ag=paid-faster: {HEADLINES['paid-faster']}</li>
      <li>ag=ar-collections: {HEADLINES['ar-collections']}</li>
    </ul>
  </section>

  <!-- 2. AR calculator (first step) -->
  <section id="calculator" class="wrap section-tight" aria-labelledby="calc-h">
    <div class="sec-head">
      <h2 id="calc-h" class="h2">What is your AR costing you?</h2>
      <span class="meta">Step 1 of 2 · AR calculator</span>
    </div>
    <p class="calc-intro">Enter your monthly revenue and how long it takes to get paid. You will see the cash tied up in AR, then enter your email to get the results. The 20-minute call comes after that.</p>

    <div class="calc" data-ar-calc>
      <form class="calc-inputs" novalidate aria-label="Your numbers" onsubmit="return false">
        <label class="field">
          <span>Monthly revenue</span>
          <span class="money"><span aria-hidden="true">$</span><input class="input" name="monthly_revenue" inputmode="decimal" autocomplete="off" placeholder="0" data-calc="monthly" data-money aria-describedby="calc-monthly-err" /></span>
          <span class="field-err" id="calc-monthly-err" hidden></span>
        </label>
        <label class="field">
          <span>Average days to get paid</span>
          <input class="input" name="days" type="number" min="0" max="3650" step="1" inputmode="numeric" placeholder="0" data-calc="days" aria-describedby="calc-days-err" />
          <span class="field-err" id="calc-days-err" hidden></span>
        </label>
        <p class="calc-how">{AR_FORMULA}</p>
      </form>

      <div class="calc-out" aria-live="polite">
        <div class="out-row out-main">
          <p class="out-k">Cash tied up in AR</p>
          <p class="out-v" data-out="tied">—</p>
        </div>
        <div class="out-foot" data-email-step hidden>
          <p class="out-proof">Enter your email to get these results. We will also use it to follow up about a 20-minute call.</p>
          <div class="contact-form-wrap" data-form-wrap>
            <form class="form calc-email-form" method="post" action="/api/contact" data-contact-form data-ar-results-form novalidate>
              <label class="field"><span>Name</span><input class="input" name="name" autocomplete="name" required maxlength="120" /></label>
              <label class="field"><span>Email</span><input class="input" type="email" name="email" autocomplete="email" required maxlength="200" /></label>
              <div class="hp" aria-hidden="true"><label>Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label></div>
              <input type="hidden" name="source" value={OFFER.source} />
              <input type="hidden" name="monthly_revenue" value="" data-sync="monthly_revenue" />
              <input type="hidden" name="days_to_paid" value="" data-sync="days_to_paid" />
              <input type="hidden" name="cash_tied_up" value="" data-sync="cash_tied_up" />
              <input type="hidden" name="t" value="" />
              <input type="hidden" name="utm" value="" />
              <input type="hidden" name="sid" value="" />
              <input type="hidden" name="vid" value="" />
              <button type="submit" class="btn btn-primary full"><span>Email me the results</span><span aria-hidden="true">→</span></button>
              <p class="form-status full" role="status" aria-live="polite" hidden></p>
              <p class="form-note full">We never share your details. See our <a href="/privacy">privacy policy</a>.</p>
            </form>
            <div class="success-box booking" hidden tabindex="-1">
              <p class="num">Step 2 of 2</p>
              <h3>Thanks. Now pick a time for your 20-minute call.</h3>
              <p class="body">Your results are on their way to your inbox.</p>
              {bookingUrl && isCalendly ? (
                <CalendlyInline url={bookingUrl} prefillFrom="form[data-ar-results-form]" label="Pick a time for your 20-minute call" />
              ) : bookingUrl ? (
                <a href={bookingUrl} class="btn btn-primary" rel="noopener" target="_blank" data-booking><span>Pick a time</span><span aria-hidden="true">↗</span></a>
              ) : (
                <p class="need">[need: booking link]</p>
              )}
              <p class="body">Or call <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Proof -->
  <section class="wrap section-tight" aria-labelledby="proof-h">
    <div class="sec-head"><h2 id="proof-h" class="h2">Results from past engagements</h2></div>
    <div class="grid-cells proof" style="--min:320px">
      {PROOF.map((p) => (
        <figure class="cell proof-cell">
          <p class="proof-meta"><span>{p.year}</span><span>{p.firm}</span></p>
          <p class="proof-fig">{p.figure}<span class="proof-fig-l">{p.figureLabel}</span></p>
          <figcaption>{p.text}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- 4. What's included -->
  <section class="wrap section-tight" aria-labelledby="inc-h">
    <div class="sec-head">
      <h2 id="inc-h" class="h2">What's included</h2>
      <span class="need">[need: confirm stack]</span>
    </div>
    <div class="grid-cells" style="--min:260px">
      {INCLUDED.map((t, i) => (
        <div class="cell inc-cell">
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{t}</h3>
        </div>
      ))}
    </div>
  </section>

  <!-- 5. Guarantee -->
  <section id="guarantee" class="band" aria-labelledby="g-h">
    <div class="wrap section g-grid">
      <div>
        <p class="g-k">The guarantee</p>
        <h2 id="g-h" class="display-sm">{OFFER.guarantee}</h2>
      </div>
      <div class="g-body">
        <p>We measure your AR over 90 days on day 1 and again on day 90.</p>
        <p>If it isn't lower on day 90 than on day 1, you choose: we keep working until it is, or you get your money back.</p>
        <p class="g-req"><strong>System access is required.</strong> It's how we set the day-1 baseline and run the day-90 check.</p>
      </div>
    </div>
  </section>

  <!-- 6. Price and how it works -->
  <section class="wrap section" aria-labelledby="price-h">
    <div class="sec-head"><h2 id="price-h" class="h2">Price and how it works</h2></div>
    <div class="price-grid">
      <div class="price">
        <p class="price-k">Price</p>
        <p class="price-v">{usd(OFFER.pricePerMonth)}<span>/month</span></p>
        <p class="price-p">for 90 days, all-inclusive.</p>
        <p class="price-g">{OFFER.guarantee}</p>
      </div>
      <ol class="timeline">
        {STEPS.map((s) => (
          <li>
            <span class="tl-k">{s.k}</span>
            <div>
              <h3>{s.h}</h3>
              <p>{s.p}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

</Base>

<script>
  import { initContactForms } from '~/scripts/contact';
  import { initArCalculator } from '~/scripts/ar-calc';
  import { initHeadline } from '~/scripts/headline';
  import { initAdsConversions } from '~/scripts/ads-conversions';
  initHeadline();
  initContactForms();
  initArCalculator();
  initAdsConversions();
</script>

<style>
  .butter { color: var(--butter); }
  .nowrap { white-space: nowrap; }

  /* Hero */
  .cff-hero { padding-top: clamp(48px, 7vw, 104px); padding-bottom: clamp(48px, 6vw, 88px); }
  .hero-grid { display: grid; gap: 48px; align-items: end; grid-template-columns: minmax(0, 1fr) minmax(0, 360px); }
  .hero-h { margin-top: 20px; font-size: clamp(48px, 8vw, 120px); }
  .hero-lede { margin-top: 28px; max-width: 640px; font-size: clamp(18px, 1.6vw, 21px); }
  .seal { border: 2px solid var(--butter); padding: 28px 24px; display: flex; flex-direction: column; gap: 12px; }
  .seal-k { font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--butter); }
  .seal-h { font-stretch: 125%; font-weight: 800; font-size: 30px; line-height: 1.02; letter-spacing: -0.025em; text-wrap: balance; }
  .seal-p { font-size: 15px; line-height: 1.5; color: var(--text-3); }
  .facts { list-style: none; margin: 56px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); border-top: 2px solid var(--white); }
  .facts li { padding: 16px 24px 0 0; font-size: 16px; line-height: 1.45; color: var(--text-2); display: flex; flex-direction: column; gap: 6px; }
  .facts-k { font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ice); }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .seal { max-width: 520px; }
  }

  /* Calculator */
  #calculator, #intake, #guarantee { scroll-margin-top: calc(var(--header-h) + 16px); }
  .calc-intro { font-size: 17px; line-height: 1.55; color: var(--text-3); margin: -24px 0 32px; max-width: 640px; }
  .calc { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); border: 2px solid var(--line); }
  .calc-inputs { display: grid; gap: 22px; padding: clamp(24px, 3vw, 40px); align-content: start; }
  .calc-out { background: var(--surface); border-left: 2px solid var(--line); display: flex; flex-direction: column; }
  .out-row { padding: 22px clamp(24px, 3vw, 40px); border-bottom: 2px solid var(--line); }
  .out-k { font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ice); }
  .out-v { font-stretch: 125%; font-weight: 800; font-size: clamp(34px, 3.6vw, 48px); letter-spacing: -0.03em; line-height: 1.05; margin-top: 8px; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .out-main .out-v { color: var(--butter); font-size: clamp(40px, 4.6vw, 64px); }
  .out-note { font-size: 14px; color: var(--muted); margin-top: 6px; }
  .out-foot { padding: 24px clamp(24px, 3vw, 40px) clamp(24px, 3vw, 36px); display: flex; flex-direction: column; gap: 18px; margin-top: auto; }
  .out-proof { font-size: 16px; line-height: 1.5; color: var(--text-2); border-left: 2px solid var(--butter); padding-left: 12px; }
  .out-foot .btn { justify-content: space-between; text-align: left; }
  .money { position: relative; display: block; }
  .money > span { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--muted); font-size: 17px; letter-spacing: 0; pointer-events: none; }
  .money .input { padding-left: 30px; }
  .calc-how { margin-top: auto; padding-top: 18px; border-top: 2px solid var(--line); font-size: 14px; line-height: 1.5; color: var(--muted); }
  .field-err { font-size: 14px; letter-spacing: 0; text-transform: none; color: #ff8a7a; }
  .calc .input[aria-invalid='true'] { border-color: #ff8a7a; }
  @media (max-width: 860px) {
    .calc { grid-template-columns: 1fr; }
    .calc-out { border-left: 0; border-top: 2px solid var(--line); }
  }


  .hero-terms, .hero-proof { margin-top: 16px; max-width: 640px; font-size: 17px; line-height: 1.55; color: var(--text-2); }
  .hero-terms { margin-top: 22px; padding-left: 12px; border-left: 2px solid var(--butter); }
  .hero-proof { color: var(--text-3); }
  .hero-actions { margin-top: 28px; }
  .calc-email-form { display: grid; gap: 16px; }
  .calc-email-form .field span { font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ice); }
  .calc-email-form .form-note, .calc-email-form .form-status { margin: 0; }
  .calc-out .booking { margin-top: 8px; }

  /* Proof */
  .proof-cell { margin: 0; padding: 32px 28px 36px; gap: 18px; }
  .proof-meta { display: flex; gap: 12px; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ice); }
  .proof-meta span + span::before { content: '·'; margin-right: 12px; color: var(--muted); }
  .proof-fig { font-stretch: 125%; font-weight: 800; font-size: clamp(64px, 8vw, 112px); line-height: 0.9; letter-spacing: -0.04em; color: var(--butter); display: flex; flex-direction: column; gap: 10px; }
  .proof-fig-l { font-stretch: 100%; font-size: 16px; font-weight: 700; letter-spacing: 0; color: var(--white); text-transform: lowercase; }
  .proof-cell figcaption { font-size: 18px; line-height: 1.55; color: var(--text-2); text-wrap: pretty; }

  /* Included */
  .inc-cell { min-height: 180px; }
  .inc-cell h3 { margin-top: auto; }

  /* Placeholder for unconfirmed content. Remove before launch. */
  .need { display: inline-block; border: 2px dashed var(--butter); color: var(--butter); padding: 6px 10px; font-size: 14px; font-weight: 700; letter-spacing: 0.02em; }

  /* Guarantee */
  .g-grid { display: grid; gap: 48px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); align-items: end; }
  .g-k { font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; margin-bottom: 20px; }
  .g-body { border-top: 2px solid var(--black); padding-top: 20px; display: flex; flex-direction: column; gap: 14px; font-size: 19px; line-height: 1.55; }
  .g-req { font-size: 17px; }

  /* Price */
  .price-grid { display: grid; gap: 48px; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: start; }
  .price { border: 2px solid var(--ice); padding: 32px 28px; display: flex; flex-direction: column; gap: 10px; }
  .price-k { font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ice); }
  .price-v { font-stretch: 125%; font-weight: 800; font-size: clamp(48px, 5.6vw, 76px); line-height: 1; letter-spacing: -0.035em; font-variant-numeric: tabular-nums; }
  .price-v span { font-size: 0.36em; letter-spacing: -0.01em; color: var(--text-2); margin-left: 4px; }
  .price-p { font-size: 19px; color: var(--text-2); }
  .price-g { margin-top: 14px; padding-top: 14px; border-top: 2px solid var(--line); font-weight: 700; color: var(--butter); }
  .timeline { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--white); }
  .timeline li { display: grid; grid-template-columns: 96px 1fr; gap: 20px; padding: 22px 0; border-bottom: 2px solid var(--line); }
  .tl-k { font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ice); padding-top: 5px; }
  .timeline h3 { font-size: 22px; line-height: 1.2; letter-spacing: -0.01em; }
  .timeline p { font-size: 16px; line-height: 1.55; color: var(--text-3); margin-top: 6px; }
  @media (max-width: 860px) {
    .price-grid { grid-template-columns: 1fr; }
    .timeline li { grid-template-columns: 1fr; gap: 6px; }
  }

  /* Intake */
  .intake-grid { display: grid; gap: 56px; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: start; }
  .rule-top { border-top: 2px solid var(--white); padding-top: 16px; }
  .intake-copy { position: sticky; top: calc(var(--header-h) + 24px); display: flex; flex-direction: column; gap: 24px; }
  .intake-lede { font-size: 18px; max-width: 460px; }
  .intake-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; font-size: 17px; }
  .intake-steps li { display: flex; align-items: center; gap: 14px; }
  .intake-steps span { width: 32px; height: 32px; flex: none; display: grid; place-items: center; border: 2px solid var(--ice); color: var(--ice); font-weight: 700; font-size: 14px; }
  .intake-contact { --gap: 6px; font-size: 17px; }
  .intake-contact a { color: var(--white); text-decoration: none; }
  .intake-contact a:hover { color: var(--ice); }
  .form-legend { font-size: 14px; color: var(--muted); }
  .form-sep { font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); border-top: 2px solid var(--line); padding-top: 14px; margin-top: 8px; }
  .field.q > span:first-child, .pick legend { font-size: 16px; letter-spacing: 0; text-transform: none; color: var(--white); line-height: 1.4; }
  .field.q b { color: var(--ice); font-weight: 700; margin-right: 2px; }
  .field.q .opt { font-size: 14px; }
  .pick { border: 0; padding: 0; margin: 0; min-width: 0; }
  .pick legend { padding: 0; margin-bottom: 10px; }
  .pick-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .pick-opt { position: relative; cursor: pointer; }
  .pick-opt input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .pick-opt span { display: inline-block; padding: 9px 14px; border: 2px solid var(--line-2); font-size: 15px; letter-spacing: 0; text-transform: none; color: var(--text-2); }
  .pick-opt input:checked + span { border-color: var(--ice); background: var(--ice); color: var(--black); }
  .pick-opt input:focus-visible + span { outline: 2px solid var(--white); outline-offset: 2px; }
  .booking { gap: 16px; }
  .booking .btn { align-self: flex-start; }
  .booking a:not(.btn) { color: var(--ice); }
  @media (max-width: 960px) {
    .intake-grid { grid-template-columns: 1fr; gap: 40px; }
    .intake-copy { position: static; }
  }
  @media (max-width: 560px) {
    .intake-form { grid-template-columns: 1fr; }
    /* Give the Calendly embed its 320px minimum on phones; the text keeps the box padding. */
    .out-foot:has(.booking:not([hidden])) { padding-left: 6px; padding-right: 6px; }
    .booking { padding-left: 20px; padding-right: 20px; }
    .booking :global(.cal-embed) { margin-left: -18px; margin-right: -18px; }
  }
</style>

---
import Base from '~/layouts/Base.astro';
---
<Base title="Request received | FalcoDash" description="We have your request and will reach out to schedule your free audit." path="/contact/thanks" noindex>
  <section class="wrap section">
    <div class="success-box" style="max-width:720px">
      <p class="eyebrow">Request received</p>
      <h1 class="display-sm" style="font-size:clamp(36px,5vw,64px)">Thanks. We have your request.</h1>
      <p class="lede">We'll reach out within one business day to schedule your free audit. A confirmation is on its way to your inbox.</p>
      <p><a href="/blog" class="link-arrow">Read the blog while you wait →</a></p>
    </div>
  </section>
</Base>

---
// First-party analytics always run (GPC skips the visitor ID). Clarity still
// depends on PUBLIC_CLARITY_ID and loads only after consent, never under GPC.
// The Google tag (Ads / GA4) lives in GoogleTag.astro so consent defaults run first.
const clarity = import.meta.env.PUBLIC_CLARITY_ID || '';
const cf = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const cfg = JSON.stringify({ clarity });
---
{(clarity) && (
  <script is:inline define:vars={{ cfg }}>
    (function () {
      var c = JSON.parse(cfg);
      function allowed() {
        if (navigator.globalPrivacyControl) return false;
        try { return localStorage.getItem('fd_cookie_consent') === 'accepted'; } catch (e) { return false; }
      }
      function loadClarity() {
        if (!c.clarity || window.__fdClarity) return;
        if (!allowed()) return;
        window.__fdClarity = true;
        (function (w, d, t, i) {
          w.clarity = w.clarity || function () { (w.clarity.q = w.clarity.q || []).push(arguments); };
          var s = d.createElement(t); s.async = 1; s.src = 'https://www.clarity.ms/tag/' + i;
          d.head.appendChild(s);
        })(window, document, 'script', c.clarity);
      }
      if (allowed()) {
        if (document.readyState === 'complete') loadClarity();
        else addEventListener('load', loadClarity);
      }
      document.addEventListener('fd-consent', function (e) {
        if (e.detail && e.detail.accepted) loadClarity();
      });
    })();
  </script>
)}
{cf && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cf })}></script>}
<script>
  import { initTracking } from '~/scripts/track';
  import { initAdsConversions } from '~/scripts/ads-conversions';
  import { initConsentBanner } from '~/scripts/consent';
  initTracking();
  initConsentBanner();
  initAdsConversions();
</script>

---
// Calendly inline booking embed (Calendly's official inline widget, initialised with
// Calendly.initInlineWidget). The widget script loads only on pages that render this component,
// and only once the embed scrolls into view or is revealed (it is often inside a hidden step).
// When the visitor books, the Calendly iframe posts `calendly.event_scheduled` to this window;
// src/scripts/ads-conversions.ts listens for it (calendly.com origin only) and fires call_booked.
// No-JS / blocked-script fallback: the plain booking link below always stays on the page.
interface Props {
  url: string;
  /** Optional selector of a form whose name/email fields prefill the Calendly booking form. */
  prefillFrom?: string;
  label?: string;
}
const { url, prefillFrom = '', label = 'Pick a time for your call' } = Astro.props;
---
<div class="cal-embed" data-calendly-embed data-url={url} data-prefill-from={prefillFrom || undefined}>
  <div class="cal-mount" data-calendly-mount aria-label={label} role="region">
    <p class="cal-loading">Loading the calendar…</p>
  </div>
  <p class="cal-fallback">
    Calendar not loading? <a href={url} target="_blank" rel="noopener" data-booking>Open the booking page<span aria-hidden="true"> ↗</span></a>
  </p>
</div>

<script>
  const SCRIPT_SRC = 'https://assets.calendly.com/assets/external/widget.js';
  let loading: Promise<void> | null = null;

  function loadCalendly(): Promise<void> {
    const w = window as any;
    if (w.Calendly?.initInlineWidget) return Promise.resolve();
    if (loading) return loading;
    loading = new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = SCRIPT_SRC;
      s.async = true;
      s.onload = () => resolve();
      s.onerror = () => { loading = null; reject(new Error('calendly script failed')); };
      document.head.appendChild(s);
    });
    return loading;
  }

  function prefillFor(root: HTMLElement) {
    const sel = root.dataset.prefillFrom;
    const form = sel ? document.querySelector<HTMLFormElement>(sel) : null;
    if (!form) return {};
    const name = (form.elements.namedItem('name') as HTMLInputElement | null)?.value.trim() || '';
    const email = (form.elements.namedItem('email') as HTMLInputElement | null)?.value.trim() || '';
    const out: Record<string, string> = {};
    if (name) out.name = name;
    if (email) out.email = email;
    return out;
  }

  function mount(root: HTMLElement) {
    if (root.dataset.calendlyState) return;
    root.dataset.calendlyState = 'loading';
    loadCalendly()
      .then(() => {
        const el = root.querySelector<HTMLElement>('[data-calendly-mount]');
        if (!el) return;
        el.innerHTML = '';
        (window as any).Calendly.initInlineWidget({
          url: root.dataset.url,
          parentElement: el,
          prefill: prefillFor(root),
        });
        root.dataset.calendlyState = 'ready';
      })
      .catch(() => {
        // Leave the plain link; it is always visible below the mount.
        root.dataset.calendlyState = 'failed';
      });
  }

  function init() {
    const roots = document.querySelectorAll<HTMLElement>('[data-calendly-embed]');
    if (!roots.length) return;
    if (!('IntersectionObserver' in window)) { roots.forEach(mount); return; }
    // Hidden ancestors (hidden attribute) never intersect, so this waits until the step is shown.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { io.unobserve(e.target); mount(e.target as HTMLElement); }
      }
    }, { rootMargin: '200px 0px' });
    roots.forEach((r) => io.observe(r));
  }

  init();
</script>

<style>
  .cal-embed { display: flex; flex-direction: column; gap: 10px; }
  .cal-mount { min-width: 280px; height: 700px; background: var(--white); border: 2px solid var(--line-2); overflow: hidden; }
  .cal-mount :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  .cal-loading { margin: 0; padding: 24px; color: var(--black); font-size: 15px; }
  .cal-fallback { margin: 0; font-size: 14px; color: var(--muted); }
  .cal-fallback a { color: var(--ice); }
  @media (max-width: 560px) { .cal-mount { height: 760px; border-width: 2px 0; } }
</style>
